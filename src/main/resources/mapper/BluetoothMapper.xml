<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kmbeast.mapper.BluetoothMapper">

    <insert id="insertBatch">
        INSERT INTO health_record (user_id, health_model_id, value, create_time)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (
            #{item.userId},
            #{item.healthModelId},
            #{item.value},
            #{item.createTime}
            )
        </foreach>
    </insert>

</mapper>