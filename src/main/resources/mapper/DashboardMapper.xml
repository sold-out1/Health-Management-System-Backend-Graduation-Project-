<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kmbeast.mapper.DashboardMapper">

    <!-- 公共SQL片段：类型统计基础查询 -->
    <sql id="typeCountBase">
        SELECT type_id AS id,
        COUNT(*) AS count
        FROM ${tableName}
        WHERE type_id IN
        <foreach collection="typeIds" item="typeId" open="(" close=")" separator=",">
            #{typeId}
        </foreach>
        GROUP BY type_id
        ORDER BY type_id
    </sql>

    <!-- 健康资讯类型统计 -->
    <select id="newsContentType" resultType="com.kmbeast.pojo.vo.ContentTypeVO">
        <include refid="typeCountBase">
            <property name="tableName" value="health_news"/>
        </include>
    </select>

    <!-- 食谱类型统计 -->
    <select id="recipeContentType" resultType="com.kmbeast.pojo.vo.ContentTypeVO">
        <include refid="typeCountBase">
            <property name="tableName" value="recipe"/>
        </include>
    </select>

    <!-- 静态数量统计 -->
    <select id="staticCount" resultType="com.kmbeast.pojo.vo.StaticCountVO">
        SELECT (SELECT COUNT(*) FROM user)         AS userCount,
               (SELECT COUNT(*) FROM health_model) AS modelCount,
               (SELECT COUNT(*) FROM health_news)  AS healthNewsCount,
               (SELECT COUNT(*) FROM recipe)       AS recipeCount
    </select>

</mapper>