<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kmbeast.mapper.HealthGoalMapper">

    <resultMap id="BaseResultMap" type="com.kmbeast.pojo.entity.HealthGoal">
        <id column="id" property="id" />
        <result column="user_id" property="userId" />
        <result column="type" property="type" />
        <result column="current_value" property="currentValue" />
        <result column="target_value" property="targetValue" />
        <result column="start_time" property="startTime" />
        <result column="end_time" property="endTime" />
        <result column="status" property="status" />
        <result column="remark" property="remark" />
        <result column="create_time" property="createTime" />
    </resultMap>

    <sql id="Base_Column_List">
        id, user_id, type, current_value, target_value, start_time, end_time, status, remark, create_time
    </sql>

    <select id="selectExpiringGoals" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM health_goal
        WHERE user_id = #{userId} AND status = 0
        AND end_time &lt;= DATE_ADD(NOW(), INTERVAL 3 DAY)
    </select>

</mapper>